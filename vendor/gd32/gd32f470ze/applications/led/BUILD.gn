import("//kernel/liteos_m/liteos.gni")

# LED blink application (1 Hz) for GD32F470ZE, registered via APP_FEATURE_INIT.
# GPIO allocation: PA8=LED_GREEN, PE3=LED_BLUE (see docs/io_allocation.md).
# The entry is launched by the bootstrap service (BOOT_SYS_COMPLETED) during
# OHOS_SystemInit() at boot, so no module_switch gating is required -- it does
# not define LosAppInit and cannot clash with the kernel testsuites.
kernel_module("led_app") {
  sources = [ "led_app.c" ]

  include_dirs = [
    # ohos_init.h (APP_FEATURE_INIT) and led.h (board LED driver, PA8/PE3).
    # los_task.h reaches this module via the kernel :public config chain
    # (kernel_module set_defaults -> kernel:public).
    "//commonlibrary/utils_lite/include",
    "//device/board/gd32/gd32f470ze/liteos_m/board/include",
  ]
}
