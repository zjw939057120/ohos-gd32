import("//kernel/liteos_m/liteos.gni")

# Hello World sample application for GD32F470ZE, registered via APP_FEATURE_INIT.
# Prints "Hello World!" on the debug console (USART0) once per second using the
# native LiteOS task API (LOS_TaskCreate/LOS_TaskDelay). The entry is launched by
# the bootstrap service (BOOT_SYS_COMPLETED) during OHOS_SystemInit() at boot.
# los_task.h reaches this module via the kernel :public config chain
# (kernel_module set_defaults -> kernel:public).
kernel_module("helloworld") {
  sources = [ "helloworld.c" ]

  include_dirs = [
    "//commonlibrary/utils_lite/include", # ohos_init.h
  ]
}
