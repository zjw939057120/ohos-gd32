LOSCFG_SOC_SERIES_GD32F470=y
LOSCFG_SOC_GD32F470ZE=y
LOSCFG_BOARD_GD32F470ZE=y
LOSCFG_KERNEL_BACKTRACE=y
LOSCFG_KERNEL_CPUP=y
LOSCFG_SHELL=y
# Disable unaligned-access trap: GCC -fstore-merging (-O2) merges musl memset
# byte stores into unaligned halfword stores (strh [dest+1]); with
# CCR.UNALIGN_TRP=1 that faults during LOS_KernelInit->OsTaskInit on Cortex-M4
# (the MVE-gated asm safe memset is not built without __ARM_FEATURE_MVE).
# Cortex-M4 handles unaligned SRAM access in hardware, so the trap is unneeded.
# LOSCFG_ARCH_UNALIGNED_EXC is not set
