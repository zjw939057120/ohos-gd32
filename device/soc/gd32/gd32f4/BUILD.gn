# GD32F470ZG SoC support: CMSIS + standard peripheral library (rcu/gpio/usart/misc)
# and the system clock init. Board code consumes the headers via :public and the
# compiled objects via the kernel libkernel (this module is a kernel dependency).

import("//kernel/liteos_m/liteos.gni")

module_name = get_path_info(rebase_path("."), "name")

FW_DIR = "GD32F4xx_Firmware"
CMSIS_DIR = "$FW_DIR/CMSIS"
DEV_INC_DIR = "$CMSIS_DIR/GD/GD32F4xx/Include"
PERIPH_INC_DIR = "$FW_DIR/GD32F4xx_standard_peripheral/Include"
PERIPH_SRC_DIR = "$FW_DIR/GD32F4xx_standard_peripheral/Source"

kernel_module(module_name) {
  sources = [
    "$CMSIS_DIR/GD/GD32F4xx/Source/system_gd32f4xx.c",
    "$PERIPH_SRC_DIR/gd32f4xx_gpio.c",
    "$PERIPH_SRC_DIR/gd32f4xx_misc.c",
    "$PERIPH_SRC_DIR/gd32f4xx_rcu.c",
    "$PERIPH_SRC_DIR/gd32f4xx_usart.c",
  ]

  include_dirs = [
    ".",
    "include",
    CMSIS_DIR,
    DEV_INC_DIR,
    PERIPH_INC_DIR,
  ]
}

config("public") {
  include_dirs = [
    ".",
    "include",
    CMSIS_DIR,
    DEV_INC_DIR,
    PERIPH_INC_DIR,
  ]
}
