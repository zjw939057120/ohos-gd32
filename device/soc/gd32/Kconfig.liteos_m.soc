config SOC_GD32F470VG
    bool "gd32f470vg"
    depends on SOC_SERIES_GD32F470
    help
        GigaDevice GD32F470VG SoC (Cortex-M4F, 1024KB Flash).

config SOC_GD32F470ZI
    bool "gd32f470zi"
    depends on SOC_SERIES_GD32F470
    help
        GigaDevice GD32F470ZI SoC (Cortex-M4F, 512KB Flash, LQFP144).

config SOC_COMPANY
    default "gd32" if SOC_GD32F470VG
    default "gd32" if SOC_GD32F470ZI
