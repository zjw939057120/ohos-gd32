# Board support: startup, linker, console UART, main and printf.
# The application lives under vendor/gd32/gd32f470zi/applications and is started
# via the OHOS bootstrap (OHOS_SystemInit -> SYS_RUN), not compiled here.
# The GD32F4xx SoC (CMSIS + peripheral library, system_gd32f4xx) lives under
# device/soc/gd32/gd32f4 and is pulled in as a kernel dependency; its header
# paths reach this module via the kernel :public config chain.

import("//kernel/liteos_m/liteos.gni")

module_name = "bsp_config"

kernel_module(module_name) {
  asmflags = board_asmflags

  sources = [
    "main.c",
    "${ohos_root_path}/device/board/gd32/components/startup/startup_gd32f450_470.S",
    "libc/dprintf.c",
  ]

  include_dirs = [
    ".",
    "include",
    "driver",
    "libc",
  ]
}

config("public") {
  include_dirs = [
    ".",
    "include",
    "driver",
    "libc",
  ]

  ldflags = [
    "-nostartfiles",
    "-Wl,-T" + "${ohos_root_path}device/board/gd32/components/ld/gd32f470xI_flash.ld",
    "-nostdlib",
  ]

  libs = [
    "nosys",
    "gcc",
  ]

  if (defined(LOSCFG_LIBC_NEWLIB)) {
    ldflags -= [ "-nostdlib" ]
    libs -= [ "nosys" ]
    libs += [
      "c",
      "m",
    ]
  }
}
