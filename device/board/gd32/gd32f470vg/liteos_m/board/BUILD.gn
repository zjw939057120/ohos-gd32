# Board support: startup, linker, console UART, main, printf and the sample app.
# The GD32F4xx SoC (CMSIS + peripheral library, system_gd32f4xx) lives under
# device/soc/gd32/gd32f4 and is pulled in as a kernel dependency; its header
# paths reach this module via the kernel :public config chain.

import("//kernel/liteos_m/liteos.gni")

module_name = "bsp_config"

kernel_module(module_name) {
  asmflags = board_asmflags

  sources = [
    "main.c",
    "startup.S",
    "driver/uart.c",
    "libc/dprintf.c",
  ]

  include_dirs = [
    ".",
    "include",
    "driver",
    "libc",
  ]

  if (!defined(LOSCFG_TEST)) {
    # kernel's testsuites not enabled, use our own app
    sources += [ "test/test_demo.c" ]
  }
}

config("public") {
  include_dirs = [
    ".",
    "include",
    "driver",
    "libc",
  ]

  ldflags = [
    "-nostartfiles",
    "-Wl,-T" + rebase_path("liteos.ld"),
    "-nostdlib",
  ]

  libs = [
    "nosys",
    "gcc",
  ]

  if (defined(LOSCFG_LIBC_NEWLIB)) {
    ldflags -= [ "-nostdlib" ]
    libs -= [ "nosys" ]
    libs += [
      "c",
      "m",
    ]
  }
}
